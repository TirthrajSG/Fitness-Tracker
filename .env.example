# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is loaded automatically by config.py via python-dotenv.
# Never commit the real ".env" file — only this .example is meant to be shared/committed.

# Render Postgres connection string (External Database URL for local testing,
# Internal Database URL if this app itself is also running on Render).
# Leave unset / delete this line entirely to fall back to local SQLite.
DATABASE_URL=
# Random secret used for session/CSRF signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-real-random-value
